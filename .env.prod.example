# Пример .env для продакшена — скопируйте на сервер как .env и заполните
COMPOSE_PROJECT_NAME=geekspro

WEB_PORT=8000

# ОБЯЗАТЕЛЬНО сгенерируйте новый ключ:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME

# Домен сервера
ALLOWED_HOSTS=control.example.com
CSRF_TRUSTED_ORIGINS=https://control.example.com

LANGUAGE_CODE=ru
TIME_ZONE=Asia/Bishkek

POSTGRES_DB=geekspro
POSTGRES_USER=geekspro_user
# Сильный пароль:
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Администратор создаётся автоматически при первом старте
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Публичный адрес сайта — используется там, где нет request (например,
# ботом в Telegram) для ссылок на публичные формы.
SITE_URL=https://control.example.com

# Токен бота-выпускника (apps.graduate_bot) — получить у @BotFather.
# Пусто — сервис graduate_bot откажется стартовать.
TELEGRAM_BOT_TOKEN=

# Если с сервера нет прямого маршрута до Telegram (плохой пиринг
# дата-центра — проверяется вручную), адрес SOCKS5/HTTP-релея. Пусто —
# бот ходит напрямую.
TELEGRAM_PROXY_URL=

# Общая Google-таблица резерва кадров: кандидаты попадают в неё сами,
# отсортированные по направлениям. Нужен ключ сервисного аккаунта
# (JSON из Google Cloud), а саму таблицу надо открыть на редактирование
# почте этого аккаунта (…@….iam.gserviceaccount.com).
# Файл кладём в app/secrets/ — эта папка уже смонтирована в контейнеры
# и не попадает в git. Пусто — выгрузка просто не работает.
GOOGLE_SHEETS_CREDENTIALS_FILE=
# ID таблицы из её ссылки (…/spreadsheets/d/<ID>/edit).
RESERVE_SHEET_ID=191yzysuwfWER5JmkTRU4kj7MI0Z792Rl19NPiMvSV8Q
# Лист внутри таблицы. Пусто — первый лист.
RESERVE_SHEET_TAB=
